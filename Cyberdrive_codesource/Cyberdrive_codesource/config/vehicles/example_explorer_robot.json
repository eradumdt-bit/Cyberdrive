{
  "id": "example_explorer_robot",
  "name": "Explorer Robot",
  "type": "robot",
  "description": "Autonomous exploration robot with multiple sensors and camera",
  
  "connection": {
    "preferred_mode": "serial",
    "serial": {
      "port": "AUTO",
      "baudrate": 115200,
      "description": "Main Arduino Connection"
    },
    "wifi": {
      "ip": "192.168.1.100",
      "port": 8888,
      "enabled": false
    }
  },
  
  "capabilities": {
    "max_speed_kmh": 5,
    "has_camera_onboard": true,
    "sensors": [
      "ultrasonic_front",
      "ultrasonic_back",
      "ultrasonic_left",
      "ultrasonic_right",
      "imu_mpu6050",
      "lidar_rplidar_a1",
      "camera_pi_v2",
      "battery_monitor",
      "encoder_left",
      "encoder_right"
    ],
    "actuators": [
      "dc_motor_left",
      "dc_motor_right",
      "servo_gripper",
      "servo_camera_pan",
      "servo_camera_tilt",
      "led_headlight",
      "buzzer"
    ]
  },
  
  "protocol": {
    "version": "arduino_mega_v2",
    "command_format": "CMD:MOVE:{dir}:{thr}\n",
    "telemetry_format": "TELEM:{dir}:{thr}:{dist_f}:{dist_b}:{batt}:{enc_l}:{enc_r}\n"
  },
  
  "limits": {
    "dir_min": 1000,
    "dir_max": 2000,
    "dir_center": 1500,
    "thr_min": 1000,
    "thr_max": 2000,
    "thr_neutral": 1500
  }
}
